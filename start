<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>논문 쉽게 읽기 · PDF 카드뉴스 생성기</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
<style>
  :root {
    --color-text: #1F2937;
    --color-text-sub: #6B7280;
    --color-text-faint: #9CA3AF;
    --color-bg: #F8F9FB;
    --color-surface: #FFFFFF;
    --color-border: #E5E7EB;
    --color-primary: #3B5BDB;
    --color-primary-dark: #2F4AC0;
    --color-primary-soft: #EDF2FF;
    --color-accent: #F59F00;
    --color-accent-soft: #FFF6E0;
    --color-error: #C92A2A;

    --fs-h1: 30px; --fs-h2: 21px; --fs-h3: 18px;
    --fs-body: 16px; --fs-sub: 14px; --fs-btn: 15px;

    --radius: 12px; --radius-lg: 16px;
    --shadow: 0 1px 2px rgba(31,41,55,.04), 0 8px 24px rgba(31,41,55,.06);
    --t: 180ms ease;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--fs-body);
    line-height: 1.6;
    letter-spacing: -0.01em;
    word-break: keep-all;
    -webkit-font-smoothing: antialiased;
  }
  .container { max-width: 1080px; margin: 0 auto; padding: 48px 32px 64px; }

  /* 헤더 */
  header { text-align: center; margin-bottom: 48px; }
  .badge {
    display: inline-block; padding: 4px 12px; border-radius: 999px;
    background: var(--color-primary-soft); color: var(--color-primary);
    font-size: 13px; font-weight: 600; margin-bottom: 12px;
  }
  h1 { font-size: var(--fs-h1); font-weight: 700; line-height: 1.3; }
  header p { color: var(--color-text-sub); margin-top: 8px; }

  /* 패널 공통 */
  .panel {
    background: var(--color-surface); border-radius: var(--radius-lg);
    box-shadow: var(--shadow); padding: 32px; margin-bottom: 24px;
  }
  .panel-title { font-size: var(--fs-h3); font-weight: 600; line-height: 1.4; margin-bottom: 4px; }
  .panel-desc { font-size: var(--fs-sub); color: var(--color-text-sub); margin-bottom: 16px; }

  /* API 키 */
  .field-row { display: grid; grid-template-columns: 1fr 220px; gap: 12px; }
  .field label { display: block; font-size: var(--fs-sub); font-weight: 500; margin-bottom: 8px; }
  .input-wrap { position: relative; }
  input[type="password"], input[type="text"] {
    width: 100%; height: 48px; padding: 0 16px;
    border: 1px solid var(--color-border); border-radius: var(--radius);
    font: inherit; font-size: 15px; color: var(--color-text); background: var(--color-surface);
    transition: border-color var(--t), box-shadow var(--t);
  }
  .input-wrap input { padding-right: 64px; }
  input:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-soft); }
  .toggle-key {
    position: absolute; right: 8px; top: 8px; height: 32px; padding: 0 12px;
    border: none; background: transparent; color: var(--color-text-sub);
    font: inherit; font-size: 13px; font-weight: 500; border-radius: 8px; cursor: pointer;
  }
  .toggle-key:hover { background: var(--color-bg); color: var(--color-text); }
  .hint { font-size: 13px; color: var(--color-text-faint); margin-top: 8px; }
  .hint a { color: var(--color-primary); }
  .remember { display: flex; align-items: center; gap: 8px; margin-top: 12px; font-size: var(--fs-sub); color: var(--color-text-sub); cursor: pointer; }
  .remember input { width: 16px; height: 16px; accent-color: var(--color-primary); }

  /* 업로드 */
  .dropzone {
    position: relative; border: 2px dashed #C5D0F5; border-radius: var(--radius-lg);
    background: var(--color-primary-soft); padding: 48px 24px; text-align: center;
    cursor: pointer; transition: border-color var(--t), background var(--t), transform var(--t);
  }
  .dropzone:hover, .dropzone.dragover { border-color: var(--color-primary); background: #E3EAFF; }
  .dropzone.dragover { transform: scale(1.01); }
  .dropzone:focus-within { box-shadow: 0 0 0 3px #C5D0F5; }
  .dropzone input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .drop-icon {
    width: 56px; height: 56px; margin: 0 auto 16px; border-radius: 16px;
    background: var(--color-surface); display: grid; place-items: center;
    color: var(--color-primary); box-shadow: var(--shadow);
  }
  .drop-title { font-size: var(--fs-h3); font-weight: 600; }
  .drop-sub { font-size: var(--fs-sub); color: var(--color-text-sub); margin-top: 4px; }

  .file-bar {
    display: none; align-items: center; gap: 12px; margin-top: 16px;
    padding: 12px 16px; border: 1px solid var(--color-border); border-radius: var(--radius);
  }
  .file-bar.show { display: flex; }
  .file-ic {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 10px;
    background: var(--color-primary-soft); color: var(--color-primary);
    display: grid; place-items: center; font-size: 12px; font-weight: 700;
  }
  .file-info { flex: 1; min-width: 0; }
  .file-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .file-size { font-size: 13px; color: var(--color-text-sub); }
  .btn-ghost {
    height: 36px; padding: 0 12px; border: none; border-radius: 8px; background: transparent;
    color: var(--color-text-sub); font: inherit; font-size: 13px; font-weight: 500; cursor: pointer;
    transition: background var(--t), color var(--t);
  }
  .btn-ghost:hover { background: var(--color-bg); color: var(--color-text); }

  .btn-primary {
    width: 100%; height: 52px; margin-top: 24px; border: none; border-radius: var(--radius);
    background: var(--color-primary); color: #fff; font: inherit; font-size: 16px; font-weight: 600;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: background var(--t), transform var(--t), box-shadow var(--t);
  }
  .btn-primary:hover:not(:disabled) { background: var(--color-primary-dark); box-shadow: 0 6px 16px rgba(59,91,219,.25); }
  .btn-primary:active:not(:disabled) { transform: translateY(1px); }
  .btn-primary:focus-visible { outline: 3px solid #C5D0F5; outline-offset: 2px; }
  .btn-primary:disabled { background: #C5CCE0; cursor: not-allowed; }

  .error {
    display: none; margin-top: 16px; padding: 12px 16px; border-radius: var(--radius);
    background: #FFF5F5; color: var(--color-error); font-size: var(--fs-sub); white-space: pre-wrap;
  }
  .error.show { display: block; }

  /* 로딩 */
  .loading { display: none; text-align: center; padding: 48px 24px; }
  .loading.show { display: block; }
  .spinner {
    width: 44px; height: 44px; margin: 0 auto 16px; border-radius: 50%;
    border: 4px solid var(--color-primary-soft); border-top-color: var(--color-primary);
    animation: spin .9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .loading-title { font-weight: 600; }
  .loading-sub { font-size: var(--fs-sub); color: var(--color-text-sub); margin-top: 4px; }

  /* 결과 */
  .results { display: none; margin-top: 48px; }
  .results.show { display: block; animation: fadeUp .4s ease; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .results-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
  .results-head h2 { font-size: var(--fs-h2); font-weight: 700; line-height: 1.4; }
  .paper-title { font-size: var(--fs-sub); color: var(--color-text-sub); margin-top: 4px; }

  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .card {
    background: var(--color-surface); border-radius: var(--radius-lg); box-shadow: var(--shadow);
    padding: 24px; display: flex; flex-direction: column;
  }
  .card.wide { grid-column: 1 / -1; }
  .card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .card-title { display: flex; align-items: center; gap: 12px; font-size: var(--fs-h3); font-weight: 600; line-height: 1.4; }
  .emoji {
    width: 40px; height: 40px; border-radius: 12px; background: var(--color-primary-soft);
    display: grid; place-items: center; font-size: 20px; flex-shrink: 0;
  }
  .btn-copy {
    flex-shrink: 0; height: 36px; padding: 0 12px; border: 1px solid var(--color-border);
    border-radius: 8px; background: var(--color-surface); color: var(--color-text-sub);
    font: inherit; font-size: 13px; font-weight: 500; cursor: pointer;
    transition: border-color var(--t), color var(--t);
  }
  .btn-copy:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .btn-copy.done { border-color: var(--color-primary); color: var(--color-primary); background: var(--color-primary-soft); }

  .easy-body p { margin-bottom: 12px; }
  .easy-body p:last-child { margin-bottom: 0; }
  .analogy {
    margin-top: 16px; padding: 16px; border-radius: var(--radius);
    background: var(--color-accent-soft); font-size: 15px;
  }
  .analogy strong { color: #B36B00; display: block; font-size: 13px; margin-bottom: 4px; }

  .takeaways { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .takeaways li { display: flex; gap: 12px; align-items: flex-start; padding: 16px; border-radius: var(--radius); background: var(--color-bg); }
  .num {
    flex-shrink: 0; width: 28px; height: 28px; border-radius: 8px; background: var(--color-primary);
    color: #fff; display: grid; place-items: center; font-size: 14px; font-weight: 700;
  }

  .slides { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .slide {
    position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius); padding: 20px;
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--color-surface); border: 1px solid var(--color-border);
  }
  .slide:first-child { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .slide-no { font-size: 12px; font-weight: 700; letter-spacing: .04em; color: var(--color-primary); margin-bottom: 12px; }
  .slide:first-child .slide-no { color: rgba(255,255,255,.75); }
  .slide-headline { font-size: 18px; font-weight: 700; line-height: 1.35; margin-bottom: 12px; }
  .slide:first-child .slide-headline { font-size: 21px; }
  .slide-body { font-size: 14px; line-height: 1.6; color: var(--color-text-sub); flex: 1; overflow-y: auto; }
  .slide:first-child .slide-body { color: rgba(255,255,255,.9); }
  .slide-tip { margin-top: 12px; font-size: 12px; color: var(--color-text-faint); border-top: 1px dashed var(--color-border); padding-top: 8px; }
  .slide:first-child .slide-tip { color: rgba(255,255,255,.7); border-color: rgba(255,255,255,.3); }
  .hashtags { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }
  .tag { padding: 4px 12px; border-radius: 999px; background: var(--color-primary-soft); color: var(--color-primary); font-size: 13px; font-weight: 500; }

  footer { text-align: center; font-size: 13px; color: var(--color-text-faint); margin-top: 64px; }

  @media (max-width: 860px) {
    .slides { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    :root { --fs-h1: 26px; }
    .container { padding: 32px 16px 48px; }
    header { margin-bottom: 32px; }
    .panel { padding: 20px; }
    .card { padding: 20px; }
    .field-row, .grid { grid-template-columns: 1fr; }
    .dropzone { padding: 32px 16px; }
    .slides { grid-template-columns: 1fr; }
    .slide { aspect-ratio: auto; min-height: 220px; }
  }
</style>
</head>
<body>
<div class="container">
  <header>
    <span class="badge">Gemini PDF 분석</span>
    <h1>어려운 논문, 쉽게 읽고 카드뉴스로</h1>
    <p>PDF를 올리면 쉬운 말 해설·3줄 요약·SNS 카드뉴스 구성안을 한 번에 만들어 드려요.</p>
  </header>

  <main>
    <!-- 1. API 키 -->
    <section class="panel" aria-labelledby="key-title">
      <h2 class="panel-title" id="key-title">1. Gemini API 키</h2>
      <p class="panel-desc">키는 이 브라우저에서 Google로 직접 전송되며 다른 서버를 거치지 않아요.</p>
      <div class="field-row">
        <div class="field">
          <label for="apiKey">API Key</label>
          <div class="input-wrap">
            <input type="password" id="apiKey" placeholder="AIza로 시작하는 키를 붙여 넣으세요" autocomplete="off">
            <button type="button" class="toggle-key" id="toggleKey" aria-label="키 보기">보기</button>
          </div>
        </div>
        <div class="field">
          <label for="modelName">모델</label>
          <input type="text" id="modelName" value="gemini-3.8-flash" spellcheck="false">
        </div>
      </div>
      <label class="remember"><input type="checkbox" id="rememberKey"> 이 기기에 키 저장하기 (공용 PC에서는 체크하지 마세요)</label>
      <p class="hint">키가 없다면 <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">Google AI Studio</a>에서 무료로 발급받을 수 있어요.</p>
    </section>

    <!-- 2. 업로드 -->
    <section class="panel" aria-labelledby="up-title">
      <h2 class="panel-title" id="up-title">2. 논문·보고서 PDF 업로드</h2>
      <p class="panel-desc">최대 약 15MB까지 권장해요. 스캔본 PDF도 읽을 수 있어요.</p>

      <div class="dropzone" id="dropzone">
        <input type="file" id="pdfFile" accept=".pdf,application/pdf" aria-label="PDF 파일 선택">
        <div class="drop-icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        </div>
        <p class="drop-title">PDF 파일을 여기로 끌어다 놓으세요</p>
        <p class="drop-sub">또는 클릭해서 파일 선택</p>
      </div>

      <div class="file-bar" id="fileBar">
        <div class="file-ic" aria-hidden="true">PDF</div>
        <div class="file-info">
          <div class="file-name" id="fileName"></div>
          <div class="file-size" id="fileSize"></div>
        </div>
        <button type="button" class="btn-ghost" id="removeFile">삭제</button>
      </div>

      <button type="button" class="btn-primary" id="analyzeBtn" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z"/></svg>
        PDF 분석 &amp; 카드뉴스 생성하기
      </button>
      <div class="error" id="errorBox" role="alert"></div>

      <div class="loading" id="loading" aria-live="polite">
        <div class="spinner"></div>
        <p class="loading-title">PDF 파일을 읽고 Gemini가 분석 중입니다...</p>
        <p class="loading-sub" id="loadingSub">논문 분량에 따라 20초~1분 정도 걸릴 수 있어요.</p>
      </div>
    </section>

    <!-- 3. 결과 -->
    <section class="results" id="results" aria-live="polite">
      <div class="results-head">
        <div>
          <h2>분석 결과</h2>
          <p class="paper-title" id="paperTitle"></p>
        </div>
        <button type="button" class="btn-copy" id="copyAll">전체 결과 복사</button>
      </div>

      <div class="grid">
        <article class="card">
          <div class="card-head">
            <h3 class="card-title"><span class="emoji">👧</span>초등학생도 이해하는 쉬운 말 해설</h3>
            <button type="button" class="btn-copy" data-copy="easy">복사</button>
          </div>
          <div class="easy-body" id="easyBody"></div>
          <div class="analogy" id="analogyBox"><strong>🍎 이렇게 비유하면</strong><span id="analogyText"></span></div>
        </article>

        <article class="card">
          <div class="card-head">
            <h3 class="card-title"><span class="emoji">📌</span>핵심 테이크어웨이</h3>
            <button type="button" class="btn-copy" data-copy="summary">복사</button>
          </div>
          <ol class="takeaways" id="takeaways"></ol>
        </article>

        <article class="card wide">
          <div class="card-head">
            <h3 class="card-title"><span class="emoji">📱</span>SNS 카드뉴스용 텍스트</h3>
            <button type="button" class="btn-copy" data-copy="cards">복사</button>
          </div>
          <div class="slides" id="slides"></div>
          <div class="hashtags" id="hashtags"></div>
        </article>
      </div>
    </section>
  </main>

  <footer>Powered by Google Gemini API · 결과는 AI가 생성한 것이므로 원문과 함께 확인하세요.</footer>
</div>

<script>
(() => {
  const $ = (id) => document.getElementById(id);
  const apiKeyEl = $('apiKey'), modelEl = $('modelName'), rememberEl = $('rememberKey');
  const fileInput = $('pdfFile'), dropzone = $('dropzone');
  const analyzeBtn = $('analyzeBtn'), errorBox = $('errorBox'), loading = $('loading');
  const results = $('results');
  const MAX_MB = 15;
  const STORE_KEY = 'gemini_pdf_cardnews_key';
  let selectedFile = null;
  let lastResult = null;

  // ---- 저장된 키 불러오기 ----
  try {
    const saved = localStorage.getItem(STORE_KEY);
    if (saved) { apiKeyEl.value = saved; rememberEl.checked = true; }
  } catch (e) {}

  function persistKey() {
    try {
      if (rememberEl.checked && apiKeyEl.value.trim()) localStorage.setItem(STORE_KEY, apiKeyEl.value.trim());
      else localStorage.removeItem(STORE_KEY);
    } catch (e) {}
  }
  rememberEl.addEventListener('change', persistKey);
  apiKeyEl.addEventListener('input', () => { persistKey(); updateBtn(); });

  $('toggleKey').addEventListener('click', (e) => {
    const show = apiKeyEl.type === 'password';
    apiKeyEl.type = show ? 'text' : 'password';
    e.currentTarget.textContent = show ? '숨기기' : '보기';
  });

  // ---- 파일 선택 / 드래그앤드롭 ----
  const fmtSize = (b) => b < 1024 * 1024 ? (b / 1024).toFixed(0) + ' KB' : (b / 1024 / 1024).toFixed(1) + ' MB';

  function setFile(file) {
    hideError();
    if (!file) return;
    const isPdf = file.type === 'application/pdf' || /\.pdf$/i.test(file.name);
    if (!isPdf) { showError('PDF 파일만 올릴 수 있어요.'); return; }
    if (file.size > MAX_MB * 1024 * 1024) {
      showError(`파일이 너무 커요 (${fmtSize(file.size)}). ${MAX_MB}MB 이하의 PDF를 올려 주세요.`);
      return;
    }
    selectedFile = file;
    $('fileName').textContent = file.name;
    $('fileSize').textContent = fmtSize(file.size);
    $('fileBar').classList.add('show');
    updateBtn();
  }

  fileInput.addEventListener('change', () => setFile(fileInput.files[0]));
  ['dragenter', 'dragover'].forEach(ev => dropzone.addEventListener(ev, (e) => { e.preventDefault(); dropzone.classList.add('dragover'); }));
  ['dragleave', 'drop'].forEach(ev => dropzone.addEventListener(ev, (e) => { e.preventDefault(); dropzone.classList.remove('dragover'); }));
  dropzone.addEventListener('drop', (e) => setFile(e.dataTransfer.files[0]));

  $('removeFile').addEventListener('click', () => {
    selectedFile = null; fileInput.value = '';
    $('fileBar').classList.remove('show');
    updateBtn();
  });

  function updateBtn() { analyzeBtn.disabled = !(selectedFile && apiKeyEl.value.trim()); }

  // ---- PDF → base64 (FileReader) ----
  function fileToBase64(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result).split(',')[1]);
      reader.onerror = () => reject(new Error('PDF 파일을 읽지 못했어요.'));
      reader.readAsDataURL(file);
    });
  }

  // ---- 프롬프트 & 응답 스키마 ----
  const PROMPT = `이 PDF 논문을 분석해서 1) 쉬운 말 해설, 2) 3줄 요약, 3) 4장짜리 카드뉴스 구성안을 작성해 줘.

[작성 규칙]
- 모든 내용은 한국어로 작성한다.
- title: 논문/보고서의 제목(원문 제목 그대로).
- easyExplanation: 초등학생도 이해할 수 있는 말로 2~4개 문단. 전문 용어는 풀어서 설명하고, 연구가 "왜, 무엇을, 어떻게, 그래서 무엇을 알게 됐는지"가 드러나게 한다. 문단은 배열의 원소로 나눈다.
- analogy: 이 연구 내용을 일상생활의 비유나 예시 하나로 1~2문장 설명.
- takeaways: 핵심 내용을 정확히 3개의 문장으로. 각 문장은 60자 이내, 구체적인 결과나 수치가 있으면 포함.
- cardNews: 정확히 4장. 1장은 눈길을 끄는 표지(질문형/호기심 유발 헤드라인), 2장은 연구 배경·문제, 3장은 핵심 발견, 4장은 시사점과 마무리. headline은 20자 내외, body는 2~3문장(100자 이내), designTip은 이미지·아이콘·배치 제안 한 줄.
- hashtags: SNS용 해시태그 5개 (# 포함).
- 논문에 없는 내용을 지어내지 않는다.`;

  const SCHEMA = {
    type: 'OBJECT',
    properties: {
      title: { type: 'STRING' },
      easyExplanation: { type: 'ARRAY', items: { type: 'STRING' } },
      analogy: { type: 'STRING' },
      takeaways: { type: 'ARRAY', items: { type: 'STRING' } },
      cardNews: {
        type: 'ARRAY',
        items: {
          type: 'OBJECT',
          properties: {
            slide: { type: 'INTEGER' },
            headline: { type: 'STRING' },
            body: { type: 'STRING' },
            designTip: { type: 'STRING' }
          },
          required: ['slide', 'headline', 'body']
        }
      },
      hashtags: { type: 'ARRAY', items: { type: 'STRING' } }
    },
    required: ['title', 'easyExplanation', 'analogy', 'takeaways', 'cardNews', 'hashtags']
  };

  // ---- Gemini 호출 ----
  async function callGemini(apiKey, model, base64) {
    const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent?key=${encodeURIComponent(apiKey)}`;
    const body = {
      contents: [{
        parts: [
          { inlineData: { mimeType: 'application/pdf', data: base64 } },
          { text: PROMPT }
        ]
      }],
      generationConfig: {
        temperature: 0.6,
        responseMimeType: 'application/json',
        responseSchema: SCHEMA
      }
    };
    const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json().catch(() => ({}));

    if (!res.ok) {
      const msg = data?.error?.message || res.statusText;
      if (res.status === 400 && /API key/i.test(msg)) throw new Error('API 키가 올바르지 않아요. 키를 다시 확인해 주세요.');
      if (res.status === 403) throw new Error('이 API 키로는 접근 권한이 없어요.\n' + msg);
      if (res.status === 404) throw new Error(`'${model}' 모델을 찾을 수 없어요. 모델 이름을 확인해 주세요.\n` + msg);
      if (res.status === 429) throw new Error('요청 한도를 넘었어요. 잠시 후 다시 시도해 주세요.');
      throw new Error(`Gemini 오류 (${res.status}): ${msg}`);
    }

    const cand = data?.candidates?.[0];
    if (!cand) {
      const block = data?.promptFeedback?.blockReason;
      throw new Error(block ? `요청이 차단됐어요 (${block}).` : '응답이 비어 있어요. 다시 시도해 주세요.');
    }
    const text = (cand.content?.parts || []).map(p => p.text || '').join('');
    return parseJSON(text);
  }

  function parseJSON(text) {
    let t = text.trim().replace(/^```(?:json)?\s*/i, '').replace(/```\s*$/, '');
    try { return JSON.parse(t); } catch (e) {
      const m = t.match(/\{[\s\S]*\}/);
      if (m) { try { return JSON.parse(m[0]); } catch (e2) {} }
      throw new Error('AI 응답을 해석하지 못했어요. 다시 시도해 주세요.');
    }
  }

  // ---- 분석 버튼 ----
  analyzeBtn.addEventListener('click', async () => {
    const apiKey = apiKeyEl.value.trim();
    const model = modelEl.value.trim() || 'gemini-3.8-flash';
    if (!apiKey) { showError('API 키를 입력해 주세요.'); return; }
    if (!selectedFile) { showError('PDF 파일을 선택해 주세요.'); return; }

    hideError();
    results.classList.remove('show');
    analyzeBtn.disabled = true;
    loading.classList.add('show');
    $('loadingSub').textContent = 'PDF를 변환하는 중이에요...';

    try {
      const base64 = await fileToBase64(selectedFile);
      $('loadingSub').textContent = '논문 분량에 따라 20초~1분 정도 걸릴 수 있어요.';
      const result = await callGemini(apiKey, model, base64);
      lastResult = result;
      render(result);
    } catch (err) {
      showError(err.message || String(err));
    } finally {
      loading.classList.remove('show');
      updateBtn();
    }
  });

  // ---- 렌더링 ----
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const arr = (v) => Array.isArray(v) ? v : (v ? [v] : []);

  function render(r) {
    $('paperTitle').textContent = r.title ? `📄 ${r.title}` : '';

    $('easyBody').innerHTML = arr(r.easyExplanation).map(p => `<p>${esc(p)}</p>`).join('');
    $('analogyText').textContent = r.analogy || '';
    $('analogyBox').style.display = r.analogy ? 'block' : 'none';

    $('takeaways').innerHTML = arr(r.takeaways).slice(0, 3)
      .map((t, i) => `<li><span class="num">${i + 1}</span><span>${esc(t)}</span></li>`).join('');

    $('slides').innerHTML = arr(r.cardNews).slice(0, 4).map((c, i) => `
      <div class="slide">
        <div class="slide-no">SLIDE ${String(i + 1).padStart(2, '0')}</div>
        <div class="slide-headline">${esc(c.headline)}</div>
        <div class="slide-body">${esc(c.body)}</div>
        ${c.designTip ? `<div class="slide-tip">🎨 ${esc(c.designTip)}</div>` : ''}
      </div>`).join('');

    $('hashtags').innerHTML = arr(r.hashtags)
      .map(h => `<span class="tag">${esc(h.startsWith('#') ? h : '#' + h)}</span>`).join('');

    results.classList.add('show');
    results.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ---- 복사 ----
  function textFor(kind) {
    const r = lastResult; if (!r) return '';
    if (kind === 'easy') return arr(r.easyExplanation).join('\n\n') + (r.analogy ? `\n\n🍎 비유: ${r.analogy}` : '');
    if (kind === 'summary') return arr(r.takeaways).slice(0, 3).map((t, i) => `${i + 1}. ${t}`).join('\n');
    if (kind === 'cards') return arr(r.cardNews).slice(0, 4)
      .map((c, i) => `[슬라이드 ${i + 1}] ${c.headline}\n${c.body}${c.designTip ? `\n(디자인: ${c.designTip})` : ''}`).join('\n\n')
      + (arr(r.hashtags).length ? '\n\n' + arr(r.hashtags).join(' ') : '');
    return '';
  }

  async function copyText(text, btn) {
    try { await navigator.clipboard.writeText(text); }
    catch (e) {
      const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta);
      ta.select(); document.execCommand('copy'); ta.remove();
    }
    const old = btn.textContent;
    btn.textContent = '복사됨 ✓'; btn.classList.add('done');
    setTimeout(() => { btn.textContent = old; btn.classList.remove('done'); }, 1500);
  }

  document.querySelectorAll('[data-copy]').forEach(btn =>
    btn.addEventListener('click', () => copyText(textFor(btn.dataset.copy), btn)));

  $('copyAll').addEventListener('click', (e) => {
    const r = lastResult; if (!r) return;
    const all = `📄 ${r.title || ''}\n\n👧 쉬운 말 해설\n${textFor('easy')}\n\n📌 핵심 테이크어웨이\n${textFor('summary')}\n\n📱 카드뉴스\n${textFor('cards')}`;
    copyText(all, e.currentTarget);
  });

  // ---- 오류 표시 ----
  function showError(msg) { errorBox.textContent = '⚠️ ' + msg; errorBox.classList.add('show'); }
  function hideError() { errorBox.classList.remove('show'); }

  updateBtn();
})();
</script>
</body>
